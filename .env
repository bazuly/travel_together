# Database configuration
POSTGRES_PASSWORD=postgres # for first init
DB_DRIVER=postgresql+asyncpg
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=postgres


# jwt settings
JWT_SECRET_KEY=SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30


# redis settings
CACHE_DB=0
CACHE_PORT=6379
CACHE_HOST=cache
REDIS_PASSWORD=
REDIS_URL=redis://cache:6379/0

# rabbitmq settings
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/ # our docker container url
RABBIT_PORT=5672
RABBIT_CONTROL_PANEL_PORT=15672